# Order to try providers in, comma separated. Router falls through to the
# next one if a provider errors, hits a rate limit, or has no key set.
LLM_PROVIDER_ORDER=groq,gemini,ollama

# Per-call timeout (seconds) for the Groq/Gemini API calls (Ollama has its own,
# longer default since local models are slower).
LLM_TIMEOUT_SECONDS=30

# How many times to retry with the error fed back to the model before giving up.
MAX_REPAIR_ATTEMPTS=3

# How many prior conversation messages to replay to the model per request, so
# a long iterative session doesn't blow past free-tier context limits.
MAX_HISTORY_MESSAGES=16

# Free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Local, no key needed: https://ollama.com (run `ollama pull qwen2.5-coder:7b`)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
