# Order to try providers in, comma separated. Router falls through to the
# next one if a provider errors, hits a rate limit, or has no key set.
LLM_PROVIDER_ORDER=groq,gemini,ollama

# Per-call timeout (seconds) for the Groq/Gemini API calls (Ollama has its own,
# longer default since local models are slower).
LLM_TIMEOUT_SECONDS=30

# How many times to retry with the error fed back to the model before giving up.
MAX_REPAIR_ATTEMPTS=3

# How many prior conversation messages to replay to the model per request, so
# a long iterative session doesn't blow past free-tier context limits.
MAX_HISTORY_MESSAGES=16

# When set, generating a part requires this password (the page itself stays
# viewable). Required on Vercel: generation is refused there without it.
APP_PASSWORD=

# Cap on generations per hour (per running instance on serverless hosts);
# 0 disables it.
GENERATIONS_PER_HOUR=60

# Free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Smaller model that checks each built part against the request. Groq limits
# each model separately, so this doesn't use the main model's allowance.
GROQ_REVIEW_MODEL=openai/gpt-oss-20b

# Set to 0 to skip the automatic check of built parts.
REVIEW_PARTS=1

# Free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Gemini 3 thinks before answering; "low" keeps a complex part to ~10 s instead
# of ~80 s. Leave empty for models that don't support a thinking level.
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_SECONDS=60

# Local, no key needed: https://ollama.com (run `ollama pull qwen2.5-coder:7b`)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
